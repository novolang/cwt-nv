// cwt_rfc8392_tests.nv — RFC 8392 appendix A, through cwt-nv.
//
// GENERATED by tests/generate/gen_cwt_vectors.py from the text of the RFC;
// edit the template next to the generator, not this file.
//
// The hexadecimal strings are the claims set of A.1, the keys of A.2.1 to
// A.2.3, the signed token of A.3, the MACed token of A.4 and the encrypted
// token of A.5.  Nothing here was computed by this package.
//
// The signed token is checked against the public key of A.2.3.  Its ECDSA
// signature was made with a random nonce, so it is verified and not rebuilt.
// The MACed token is rebuilt byte for byte.  The encrypted token uses
// AES-CCM-16-64-128, algorithm 10, which cose-nv does not implement: the
// package reads it as a CWT, names its kind, and refuses the algorithm.  The
// same token is decrypted by oscore-nv's CCM, whose test holds the
// Enc_structure of this message.
//
// The key of A.2.2 is written with `alg` 10 in the RFC's hexadecimal and
// with HMAC 256/64 in its diagram.  The hexadecimal is what is tested here,
// and the token is checked with the key's bytes and no `alg` member.

use std.test
use std.bytes
use std.list
use coseerr
use cosekey
use cosehdr
use cosealg
use cosemsg
use cwt
use cwtcheck
use cwtclaim
use cwtcnf

fn h(s: Str) -> Bytes
    bytes.from_hex(s) ?? bytes.zeros(0)

fn hex(b: Bytes) -> Str
    bytes.to_hex(b)

fn claims_hex() -> Str
    "@CLAIMS@"

fn key128_hex() -> Str
    "@KEY128@"

fn key256_hex() -> Str
    "@KEY256@"

fn keyec_hex() -> Str
    "@KEYEC@"

fn signed_hex() -> Str
    "@SIGNED@"

fn maced_hex() -> Str
    "@MACED@"

fn encrypted_hex() -> Str
    "@ENCRYPTED@"

fn key_of(src: Str) -> CoseKey
    match cosekey.key_from_bytes(h(src))
        Ok(k)  => k
        Err(_) => cosekey.symmetric(bytes.zeros(0))

fn said(r: Result<CwtClaims, CoseError>) -> Str
    match r
        Ok(_)  => "ok"
        Err(e) => e.message()

fn mac_key() -> CoseKey
    cosekey.symmetric(key_of(key256_hex()).k ?? bytes.zeros(0))

@test
fn test_a1_the_claims_set_reads_and_has_no_confirmation() [io]
    test.case("A.1: every registered claim")
    match cwtclaim.claims_from_bytes(h(claims_hex()))
        Err(_) => test.fail("A.1 was refused")
        Ok(c)  =>
            test.assert_eq(c.iss, Some("coap://as.example.com"))
            test.assert_eq(c.sub, Some("erikw"))
            test.assert_eq(c.aud, Some("coap://light.example.com"))
            test.assert_eq(c.exp, Some(1444064944))
            test.assert_eq(c.nbf, Some(1443944944))
            test.assert_eq(c.iat, Some(1443944944))
            test.assert_eq_str(hex(c.cti ?? bytes.zeros(0)), "0b71")
            test.case("A.1: no cnf and no private claim")
            test.assert_eq(cwtcnf.cnf_of(c), Ok(None))
            test.assert_eq(cwtclaim.claim_of(c, 8) == None, true)
            test.assert_eq(list.len(c.extra), 0)
            test.case("A.1: written again, the same bytes (the keys are already in deterministic order)")
            test.assert_eq_str(hex(cwtclaim.claims_to_bytes(c)), claims_hex())

@test
fn test_a2_the_keys_read() [io]
    test.case("A.2.2: a 256-bit symmetric key; its hex says alg 10 where its diagram says HMAC 256/64")
    let k = key_of(key256_hex())
    test.assert_eq(k.kty, 4)
    test.assert_eq(k.alg, Some(10))
    test.assert_eq_str(hex(k.kid ?? bytes.zeros(0)), "53796d6d6574726963323536")
    test.assert_eq_str(hex(k.k ?? bytes.zeros(0)), "403697de87af64611c1d32a05dab0fe1fcb715a86ab435f1ec99192d79569388")
    test.case("A.2.1: a 128-bit symmetric key")
    let s = key_of(key128_hex())
    test.assert_eq(s.alg, Some(10))
    test.assert_eq_str(hex(s.k ?? bytes.zeros(0)), "231f4c4d4d3051fdc2ec0a3851d5b383")
    test.case("A.2.3: a P-256 key with its private scalar")
    let e = key_of(keyec_hex())
    test.assert_eq(e.kty, 2)
    test.assert_eq(e.crv, Some(1))
    test.assert_eq(e.alg, Some(0 - 7))
    test.assert_eq_str(hex(e.x ?? bytes.zeros(0)), "143329cce7868e416927599cf65a34f3ce2ffda55a7eca69ed8919a394d42f0f")
    test.assert_eq_str(hex(e.y ?? bytes.zeros(0)), "60f7f1a780d8a783bfb7a2dd6b2796e8128dbbcef9d3d168db9529971a36e7b9")
    test.assert_eq_str(hex(e.d ?? bytes.zeros(0)), "6c1382765aec5358f117733d281c1c7bdc39884d04a45a1e6c67c858bc206c19")
    test.case("a key written and read again is the same key")
    match cosekey.key_from_bytes(cosekey.key_to_bytes(e))
        Err(_)    => test.fail("the rewritten key was refused")
        Ok(again) =>
            test.assert_eq_str(hex(again.x ?? bytes.zeros(0)), hex(e.x ?? bytes.zeros(0)))
            test.assert_eq_str(hex(again.d ?? bytes.zeros(0)), hex(e.d ?? bytes.zeros(0)))
            test.assert_eq(again.crv, e.crv)

@test
fn test_a3_the_signed_token_is_named_verified_and_checked() [io]
    let key = cosekey.public_part(key_of(keyec_hex()))
    let none = bytes.zeros(0)
    test.case("A.3: a COSE_Sign1 with no CWT tag")
    test.assert_eq(cwt.is_tagged(h(signed_hex())), Ok(false))
    test.assert_eq(cwt.kind_of(h(signed_hex())), Ok(Some(CwtSigned)))
    test.case("A.3: valid between nbf and exp")
    match cwt.open(h(signed_hex()), CoseEs256, key, none, cwtcheck.rules_at(1444064943))
        Err(_) => test.fail("A.3 was refused")
        Ok(c)  =>
            test.assert_eq(c.iss, Some("coap://as.example.com"))
            test.assert_eq(c.exp, Some(1444064944))
    test.case("A.3: at exp it is expired")
    test.assert_eq_str(said(cwt.open(h(signed_hex()), CoseEs256, key, none, cwtcheck.rules_at(1444064944))),
                       "cwt: expired at 1444064944, now 1444064944")
    test.case("A.3: before nbf it is not yet valid")
    test.assert_eq_str(said(cwt.open(h(signed_hex()), CoseEs256, key, none, cwtcheck.rules_at(1443944943))),
                       "cwt: not valid before 1443944944, now 1443944943")
    test.case("A.3: the audience of the claims set is the one that is accepted")
    var rules = cwtcheck.rules_at(1444064943)
    rules = CwtRules { now: rules.now, leeway: 0, issuers: ["coap://as.example.com"],
                       audience: Some("coap://light.example.com"), require_exp: true, require_nbf: true }
    test.assert_eq_str(said(cwt.open(h(signed_hex()), CoseEs256, key, none, rules)), "ok")
    test.case("A.3: another audience is refused")
    let other = CwtRules { now: 1444064943, leeway: 0, issuers: [], audience: Some("coap://heater.example.com"),
                           require_exp: true, require_nbf: false }
    test.assert_eq_str(said(cwt.open(h(signed_hex()), CoseEs256, key, none, other)),
                       "cwt: the audience is not the one required")
    test.case("A.3: another algorithm is refused before the signature is looked at")
    test.assert_eq_str(said(cwt.open(h(signed_hex()), CoseEdDSA, key, none, cwtcheck.rules_at(1444064943))),
                       "cose: the message names algorithm -7, the verifier asked for -8")
    test.case("A.3: a signature made here under the private key verifies the same way")
    match cwtclaim.claims_from_bytes(h(claims_hex()))
        Err(_) => test.fail("A.1 was refused")
        Ok(c)  =>
            let unprot = cosehdr.with_kid(cosehdr.empty(), h("4173796d6d65747269634543445341323536"))
            match cwt.sign1(CoseEs256, key_of(keyec_hex()), cosehdr.empty(), unprot, c, none, false)
                Err(_)    => test.fail("sign1 refused")
                Ok(token) => test.assert_eq_str(said(cwt.open(token, CoseEs256, key, none, cwtcheck.rules_at(1444064943))), "ok")

@test
fn test_a4_the_maced_token_under_tag_61_is_named_verified_and_rebuilt() [io]
    let none = bytes.zeros(0)
    test.case("A.4: the CWT tag is there and the COSE tag is 17")
    test.assert_eq(cwt.is_tagged(h(maced_hex())), Ok(true))
    test.assert_eq(cwt.kind_of(h(maced_hex())), Ok(Some(CwtMaced)))
    test.case("A.4: verifies under HMAC 256/64 with the key's bytes")
    match cwt.open(h(maced_hex()), CoseHmac256x64, mac_key(), none, cwtcheck.rules_at(1444064943))
        Err(_) => test.fail("A.4 was refused")
        Ok(c)  => test.assert_eq(c.sub, Some("erikw"))
    test.case("A.4: the key as the hexadecimal writes it names another algorithm")
    test.assert_eq_str(said(cwt.open(h(maced_hex()), CoseHmac256x64, key_of(key256_hex()), none,
                                     cwtcheck.rules_at(1444064943))),
                       "cose: the key is for algorithm 10, the operation uses 4")
    test.case("A.4: rebuilt from the claims, the same bytes")
    match cwtclaim.claims_from_bytes(h(claims_hex()))
        Err(_) => test.fail("A.1 was refused")
        Ok(c)  =>
            match cwt.issue_maced(CoseHmac256x64, mac_key(), Some(h("53796d6d6574726963323536")), c, none, true)
                Err(_)    => test.fail("issue_maced refused")
                Ok(token) => test.assert_eq_str(hex(token), maced_hex())
    test.case("A.4: a wrong key does not verify")
    test.assert_eq_str(said(cwt.open(h(maced_hex()), CoseHmac256x64, cosekey.symmetric(bytes.zeros(32)), none,
                                     cwtcheck.rules_at(1444064943))),
                       "cose: the signature or tag did not verify")

@test
fn test_a5_the_encrypted_token_is_named_and_its_algorithm_is_refused() [io]
    test.case("A.5: a COSE_Encrypt0 under tag 16, with no CWT tag")
    test.assert_eq(cwt.is_tagged(h(encrypted_hex())), Ok(false))
    test.assert_eq(cwt.kind_of(h(encrypted_hex())), Ok(Some(CwtEncrypted)))
    test.case("A.5: AES-CCM-16-64-128 is algorithm 10, and the verifier asked for another")
    let key = cosekey.symmetric(h("231f4c4d4d3051fdc2ec0a3851d5b383"))
    test.assert_eq_str(said(cwt.open(h(encrypted_hex()), CoseA128Gcm, key, bytes.zeros(0),
                                     cwtcheck.rules_at(1444064943))),
                       "cose: the message names algorithm 10, the verifier asked for 1")
    test.case("A.5: algorithm 10 is not implemented")
    match cosealg.alg_of_id(10)
        Ok(_)  => test.fail("algorithm 10 is not implemented")
        Err(e) => test.assert_eq_str(e.message(), "cose: algorithm 10 is not implemented")
    test.case("A.5: the token still reads as a COSE_Encrypt0 under tag 16")
    match cosemsg.encrypt0_from_bytes(h(encrypted_hex()))
        Err(_) => test.fail("A.5 does not read")
        Ok(m)  => test.assert_eq_str(hex(m.protected), "a1010a")
